# ---------------------------------------------------------------------------
# Client-safe values (VITE_ prefix is inlined into the browser bundle).
# Only publishable/anon keys belong here. Never put a secret key here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Server-side values (read via process.env in server functions / middleware).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Service role key: bypasses RLS. Used only by src/integrations/supabase/client.server.ts
# and the generate-image edge function. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Moderation dashboard (/admin)
# ---------------------------------------------------------------------------
# Password an administrator signs in with. Must be set for server-side checks
# to work; choose something long and random.
ADMIN_PASSWORD=

# Secret used to HMAC-sign the expiring moderator session token (8h TTL).
# Generate with: node -e "console.log(crypto.randomUUID())"
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Cron / edge functions (configure with `supabase secrets set`, not .env)
# ---------------------------------------------------------------------------
# Shared secret guarding scheduled endpoints, plus an optional previous value
# to allow a zero-downtime rotation.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# API key used by supabase/functions/generate-image
LOVABLE_API_KEY=
